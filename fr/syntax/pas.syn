
;********************************************************
[Source Pascal]
;********************************************************
Txttype = "pas","i"
Active = TRUE
CaseSensitive = FALSE
Token = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz"


<Commentaire>
From = "(*"
To = "*)"
(Color2)
Attribs = LIGHT
(Color16)
Color = 11
Selcolor = 3
(Color256)
Color = 11
Selcolor = 3

<Commentaire>
From = "{"
To = "}"

<Commentaire>
From = "//"
To = EOL
<Cha�ne de caract�res>
From = "'"
To = "'"
(Color16)
Color = 9
Selcolor = 9
(Color256)
Color = 9
Selcolor = 9

<Type de variable>
Keyword = "array","alfa","boolean","byte","char","integer","long_integer","word","longint","smallInt"
Keyword = "of","packed","real","short_integer","shortstring","string","text"
(Color2)
Attribs = BOLD
(Color16)
Attribs = BOLD
(Color256)
Attribs = BOLD

<Mot-cl�>
Keyword = "and"
Keyword = "begin"
Keyword = "const","case","class","constructor"
Keyword = "destructor","downto","div","do"
Keyword = "external","exit","else","end"
Keyword = "function","forward","for"
Keyword = "goto"
Keyword = "if","inherited","interface","implementation","in"
Keyword = "label","loop","mod","not","otherwise","or","object"
keyword = "procedure","private","program","public"
Keyword = "repeat","set","type","then","to","until","uses","var"
Keyword = "while","with","record","val","code"

(Color2)
Attribs = BOLD
(Color16)
Attribs = BOLD
(Color256)
Attribs = BOLD

<Constante hexad�cimale>
From = "$"
While = "0"-"9","A"-"F","a"-"f"
(Color16)
Color = 12
Selcolor = 5
(Color256)
Color = 12
Selcolor = 5

<Constante d�cimale>
From = "0"-"9"
While = ".","0"-"9"
(Color16)
Color = 12
Selcolor = 5
(Color256)
Color = 12
Selcolor = 5
